# --- Database (PostgreSQL) ---
# Локально/в РФ-облаке (Yandex Cloud / VK Cloud / Selectel Managed PostgreSQL)
DATABASE_URL="postgresql://competency:competency@localhost:5432/competency?schema=public"

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Публичный адрес фронтенда для CORS (в проде — домен колледжа)
WEB_ORIGIN=http://localhost:4000

# Отдавать статический веб-клиент из папon ../ (true для единого контейнера)
SERVE_WEB=true

# --- Auth ---
# ОБЯЗАТЕЛЬНО заменить в проде на длинные случайные значения (openssl rand -hex 48)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Пароль демо-аккаунтов при сидировании (в проде задать свой и сменить после входа)
SEED_PASSWORD="Demo!2026"
