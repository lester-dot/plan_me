# Скопируйте в .env и заполните. Файл .env НЕ коммитить.

# --- PostgreSQL (для docker-compose db) ---
POSTGRES_USER=competency
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=competency

# Порт API наружу
API_PORT=4000

# Публичный адрес фронтенда (домен колледжа в проде), для CORS
WEB_ORIGIN=http://localhost:4000

# --- Секреты аутентификации (ОБЯЗАТЕЛЬНО заменить) ---
# openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Пароль демо-аккаунтов при сидировании (сменить после первого входа)
SEED_PASSWORD=Demo!2026
